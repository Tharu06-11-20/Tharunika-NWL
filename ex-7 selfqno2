#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080

int main() {
    int sock = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in serv_addr;

    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &serv_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        printf("Connection Failed! Ensure server is running.\n");
        return -1;
    }

    int choice;
    while (1) {
        printf("\n=========================================\n");
        printf("      HOTEL RESERVATION SYSTEM MENU      \n");
        printf("=========================================\n");
        printf("1. View Room Availability\n");
        printf("2. Book a Room\n");
        printf("3. Cancel Reservation\n");
        printf("4. Check Booked Details\n");
        printf("5. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &choice);

        char payload[1024] = {0};
        char response[1024] = {0};
        int room_num = 0;
        char guest_name[50] = "None";

        if (choice == 2) {
            printf("Enter Room Number (101-110): ");
            scanf("%d", &room_num);
            printf("Enter Guest Name (Single word/No spaces): ");
            scanf("%s", guest_name);
        } else if (choice == 3) {
            printf("Enter Room Number (101-110): ");
            scanf("%d", &room_num);
            printf("Enter Guest Name to confirm cancellation: ");
            scanf("%s", guest_name);
        } else if (choice == 4) {
            printf("Enter Room Number (101-110): ");
            scanf("%d", &room_num);
        } else if (choice == 5) {
            sprintf(payload, "5 0 None");
            send(sock, payload, strlen(payload), 0);
            break;
        }

        sprintf(payload, "%d %d %s", choice, room_num, guest_name);
        send(sock, payload, strlen(payload), 0);

        recv(sock, response, sizeof(response), 0);
        printf("\n[SERVER RESPONSE]:\n%s\n", response);
    }

    close(sock);
    return 0;
}
