#include <stdio.h>
#include <ctype.h>
#include <string.h>

#define INF 999999

typedef struct {
    int nodes[20];
    int size;
} PriorityQueue;

void MakeHeap(PriorityQueue *pq, int V) {
    int i;
    pq->size = 0;
    for (i = 0; i < V; i++) {
        pq->nodes[i] = i;
        pq->size++;
    }
}

int Empty(PriorityQueue *pq) {
    return pq->size == 0;
}

int ExtractMin(PriorityQueue *pq, int dist[]) {
    int minIndex = 0;
    int minVal = dist[pq->nodes[0]];
    int u, i;

    for (i = 1; i < pq->size; i++) {
        if (dist[pq->nodes[i]] < minVal) {
            minVal = dist[pq->nodes[i]];
            minIndex = i;
        }
    }

    u = pq->nodes[minIndex];

    for (i = minIndex; i < pq->size - 1; i++) {
        pq->nodes[i] = pq->nodes[i + 1];
    }
    pq->size--;

    return u;
}

