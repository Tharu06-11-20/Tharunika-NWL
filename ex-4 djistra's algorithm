}

int main() {
    int V, E;
    int graph[20][20];
    int i, j, s, step, v, dest;

    printf("Enter number of vertices: ");
    if (scanf("%d", &V) != 1) return 1;

    for (i = 0; i < V; i++) {
        for (j = 0; j < V; j++) {
            graph[i][j] = 0;
        }
    }

    printf("Enter number of edges: ");
    if (scanf("%d", &E) != 1) return 1;

    printf("Enter edges (Source Destination Weight, e.g., A B 5):\n");
    for (i = 0; i < E; i++) {
        char u_char, v_char;
        int weight;

        while (1) {
            if (scanf(" %c %c %d", &u_char, &v_char, &weight) != 3) continue;

            if (weight < 0) {
                printf("Negative weights not allowed! Re-enter edge %d: ", i + 1);
            } else {
                int u = toupper(u_char) - 'A';
                int v_idx = toupper(v_char) - 'A';
                graph[u][v_idx] = weight;
                break;
            }
        }
    }

    for (s = 0; s < V; s++) {
        int dist[20];
        int prev[20];
        int hops[20]; // Tracks length of paths to break ties deterministically
        PriorityQueue pq;

        for (i = 0; i < V; i++) {
            dist[i] = INF;
            prev[i] = -1;
            hops[i] = 0;
        }

        dist[s] = 0;
        MakeHeap(&pq, V);

        printf("\n=======================================================================\n");
        printf("               STEP-BY-STEP DISTANCE LOG TABLE (SOURCE: %c)\n", 'A' + s);
        printf("=======================================================================\n");
        printf("%-6s | %-16s | %-20s | %-22s\n", "Step", "Extracted Node", "Path Addition", "New Shortest Distance");
        printf("-----------------------------------------------------------------------\n");

        step = 1;
        while (!Empty(&pq)) {
            int u = ExtractMin(&pq, dist);
            
            if (dist[u] == INF) {
                printf("%-6d | %-16c | %-20s | %-22s\n", step, 'A' + u, "-", "Unreachable / INF");
                step++;
                continue;
            }

            int evaluated_edges = 0;
            for (v = 0; v < V; v++) {
                if (graph[u][v] != 0) {
                    int edgeWeight = graph[u][v];
                    char addMsg[50];
                    char distMsg[50];
                    evaluated_edges++;

                    snprintf(addMsg, sizeof(addMsg), "%d + %d = %d", dist[u], edgeWeight, dist[u] + edgeWeight);

                    // Greedy tie-breaker condition checks total distance and path choice transitions
                    if (dist[u] + edgeWeight < dist[v] || (dist[u] + edgeWeight == dist[v] && (hops[u] + 1 >= hops[v]))) {
                        int oldDist = dist[v];
                        dist[v] = dist[u] + edgeWeight;
                        prev[v] = u;
                        hops[v] = hops[u] + 1;
                        DecreaseKey(&pq, v, dist[v]);

                        if (oldDist == INF) {
                            snprintf(distMsg, sizeof(distMsg), "INF -> %d", dist[v]);
                        } else if (oldDist == dist[v]) {
                            snprintf(distMsg, sizeof(distMsg), "%d -> %d (Alternative Path)", oldDist, dist[v]);
                        } else {
                            snprintf(distMsg, sizeof(distMsg), "%d -> %d (Improved!)", oldDist, dist[v]);
                        }
                    } else {
                        snprintf(distMsg, sizeof(distMsg), "%d >= %d (Ignored)", dist[u] + edgeWeight, dist[v]);
                    }
                    
                    printf("%-6d | %-16c | %-20s | %-22s\n", step, 'A' + u, addMsg, distMsg);
                }
            }

            if (evaluated_edges == 0) {
                printf("%-6d | %-16c | %-20s | %-22s\n", step, 'A' + u, "-", "No Outgoing Edges");
            }

            step++;
        }

        printf("\n---------------------------------------------------------------------------------------------------\n");
        printf("Source   | Destination   | Next Node to Visit   | Final Distance | Full Path\n");
        printf("---------------------------------------------------------------------------------------------------\n");

        for (dest = 0; dest < V; dest++) {
            printf("%-8c | %-13c | ", 'A' + s, 'A' + dest);

            if (s == dest) {
                printf("%-20s | Dist: %-8d | %c\n", "Self (0)", 0, 'A' + s);
            } else if (dist[dest] == INF) {
                printf("%-20s | Dist: %-8s | No Path\n", "None", "INF");
            } else {
                int curr = dest;
                while (prev[curr] != -1 && prev[curr] != s) {
                    curr = prev[curr];
                }
                char nextHop = 'A' + curr;

                int pathNodes[20];
                int pathCount = 0;
                curr = dest;
                while (curr != -1) {
                    pathNodes[pathCount++] = curr;
                    curr = prev[curr];
                }

                char fullPathStr[100] = "";
                int pos = 0;
                for (i = pathCount - 1; i >= 0; i--) {
                    if (i == 0) {
                        pos += snprintf(fullPathStr + pos, sizeof(fullPathStr) - pos, "%c", 'A' + pathNodes[i]);
                    } else {
                        pos += snprintf(fullPathStr + pos, sizeof(fullPathStr) - pos, "%c -> ", 'A' + pathNodes[i]);
                    }
                }

                printf("%c (Next Hop)          | Dist: %-8d | %s\n", nextHop, dist[dest], fullPathStr);
            }
        }
        printf("---------------------------------------------------------------------------------------------------\n");
    }

    return 0;
}
