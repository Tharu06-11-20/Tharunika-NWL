#include <string.h>


void injectBitError(char *hammingCode);
void processHammingReceiver(char *hammingCode);

int main() {
    FILE *file;
    char receivedCode[2000] = "";

    
    file = fopen("sender.txt", "r");
    if (file == NULL) {
        printf("Error: Could not open 'sender.txt'. Run sender first!\n");
        return 1;
    }
    fscanf(file, "%s", receivedCode);
    fclose(file);

    injectBitError(receivedCode);

   
    processHammingReceiver(receivedCode);

    return 0;
}


void injectBitError(char *hammingCode) {
    int totalBits = strlen(hammingCode);
    int choice, errorPos;

    printf("Received clean code from file: %s\n", hammingCode);
    printf("Do you want to inject a transmission error? (1 = Yes, 0 = No): ");
    scanf("%d", &choice);

    if (choice == 1) {
        printf("Enter bit position to corrupt/flip (1 to %d): ", totalBits);
        scanf("%d", &errorPos);

        if (errorPos >= 1 && errorPos <= totalBits) {
            if (hammingCode[errorPos - 1] == '0') {
                hammingCode[errorPos - 1] = '1';
            } else {
                hammingCode[errorPos - 1] = '0';
            }
            printf("[ALERT] Injected error! Corrupted code is now: %s\n\n", hammingCode);
        } else {
            printf("Invalid position. No error injected.\n\n");
        }
    } else {
        printf("Proceeding with clean, perfect data.\n\n");
    }
}


void processHammingReceiver(char *hammingCode) {
    int totalBits = strlen(hammingCode);
    int syndrome = 0;

   
    for (int pos = 1; pos <= totalBits; pos++) {
        int bitValue = hammingCode[pos - 1] - '0';
        if (bitValue == 1) {
            syndrome = syndrome ^ pos;
        }
    }

 
    if (syndrome == 0) {
        printf("Display: \"No Error Detected\"\n\n");
    }
    else {
        printf("Result: Syndrome = %d\n", syndrome);
        printf("Locating erroneous bit... Found error at position: %d\n", syndrome);

        // FLIP THE ERRONEOUS BIT (Error Correction)
        if (hammingCode[syndrome - 1] == '0') {
            hammingCode[syndrome - 1] = '1';
        } else {
            hammingCode[syndrome - 1] = '0';
        }
        printf("Display: \"Error Corrected\"\n");
        printf("Fixed Hamming Code: %s\n\n", hammingCode);
    }

  
    FILE *outputFile = fopen("receiver.txt", "w");
    if (outputFile == NULL) {
        printf("Error: Could not create or open 'receiver.txt' for writing.\n");
        return;
    }

   
    printf("Displaying Original Data: ");
    int powerOfTwo = 1;
    for (int pos = 1; pos <= totalBits; pos++) {
        if (pos == powerOfTwo) {
            powerOfTwo = powerOfTwo * 2;
        } else {
            printf("%c", hammingCode[pos - 1]);            
            fprintf(outputFile, "%c", hammingCode[pos - 1]); 
        }
    }
    printf("\n");
   
    fclose(outputFile); // Safely close file stream
    printf("Successfully extracted and saved original data to 'receiver.txt'\n");
}


