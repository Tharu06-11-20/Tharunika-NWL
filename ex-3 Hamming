#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

// Function Prototypes
int calculateParityBitsCount(int m);
void setupHammingPositions(char *binaryStream, char *hammingCode, int totalBits);
void calculateRedundancyBitsXOR(char *hammingCode, int totalBits, int r);

int main() {
    FILE *file;
    char ch;
    char binaryStream[2000] = ""; // Array to hold the file's binary data
    int r, m, totalBits;


    file = fopen("input.txt", "r");
    if (file == NULL) {
        printf("Error: Could not open input.txt. Please create this file first.\n");
        return 1;
    }

    printf("Reading data from 'input.txt' and converting to binary...\n");
    while ((ch = fgetc(file)) != EOF) {
        if (ch == '\n' || ch == '\r') continue; // Skip formatting characters

     
        for (int i = 7; i >= 0; i--) {
            if ((ch >> i) & 1) {
                strcat(binaryStream, "1");
            } else {
                strcat(binaryStream, "0");
            }
        }
    }
    fclose(file);

    m = strlen(binaryStream);
    printf("Binary data from user (m = %d bits): %s\n\n", m, binaryStream);

  
    r = calculateParityBitsCount(m);
    totalBits = m + r;

    printf("Calculated parity bits needed (r) = %d\n", r);
    printf("Total bits in Hamming Code structure (m + r) = %d\n\n", totalBits);

  
    hammingCode[totalBits] = '\0';

    
    setupHammingPositions(binaryStream, hammingCode, totalBits);
    printf("Initial layout (0s placeholders at parity positions):\n%s\n\n", hammingCode);


    calculateRedundancyBitsXOR(hammingCode, totalBits, r);

  
    printf("--- FINAL TRANSMITTED SENDER DATA ---\n");
    printf("Generated Hamming Code: %s\n", hammingCode);

    FILE *outputFile = fopen("sender.txt", "w");
    if (outputFile == NULL) {
        printf("Error: Could not create or open 'sender.txt' for writing.\n");
        return 1;
    }
    fprintf(outputFile, "%s", hammingCode);
    fclose(outputFile);
    printf("Successfully transmitted and written data to 'sender.txt'\n\n");
   
    printf("Visual layout (1-indexed left-to-right):\n");
    for (int i = 1; i <= totalBits; i++) {
        printf("| %c ", hammingCode[i - 1]);
    }
    printf("|\n");
    for (int i = 1; i <= totalBits; i++) {
        printf("  %d ", i);
    }
    printf("\n");

    return 0;
}




int calculateParityBitsCount(int m) {
    int r = 1;
    while (pow(2, r) < (m + r + 1)) {
        r++;
    }
    return r;
}

void setupHammingPositions(char *binaryStream, char *hammingCode, int totalBits) {
    int dataIndex = 0;
    int powerOfTwo = 1;

    for (int pos = 1; pos <= totalBits; pos++) {
        if (pos == powerOfTwo) {
            hammingCode[pos - 1] = '0';
            powerOfTwo *= 2;
        } else {
            hammingCode[pos - 1] = binaryStream[dataIndex];
            dataIndex++;
        }
    }
}

void calculateRedundancyBitsXOR(char *hammingCode, int totalBits, int r) {
    for (int i = 0; i < r; i++) {
        int rPos = (int)pow(2, i);
        int xorResult = 0;        

        for (int pos = 1; pos <= totalBits; pos++) {
            if ((pos & rPos) != 0) {
                if (pos != rPos) {
                    int bitValue = hammingCode[pos - 1] - '0';
                    xorResult = xorResult ^ bitValue; // Even parity calculation
                }
            }
        }

        hammingCode[rPos - 1] = (xorResult == 1) ? '1' : '0';
    }
}
