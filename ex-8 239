#include <stdio.h>

void maxSlidingWindow(int nums[], int n, int k) {
    int deque[n];
    int front = 0, rear = -1;

    for (int i = 0; i < n; i++) {

        while (front <= rear && deque[front] <= i - k) {
            front++;
        }

        while (front <= rear && nums[deque[rear]] <= nums[i]) {
            rear--;
        }

        rear++;
        deque[rear] = i;

        if (i >= k - 1) {
            printf("%d ", nums[deque[front]]);
        }
    }
}

int main() {
    int nums[] = {1, 3, -1, -3, 5, 3, 6, 7};
    int n = 8;
    int k = 3;

    printf("Output: ");
    maxSlidingWindow(nums, n, k);

    return 0;
}
