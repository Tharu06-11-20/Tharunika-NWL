        printf("3. Multiplication (*)\n");
        printf("4. Division (/)\n");
        printf("5. Exit\n");
        printf("Enter choice (1-5): ");

        if (scanf("%lf", &buffer[0]) != 1) {
            break;
        }

        if (buffer[0] == 5) {
            printf("Exiting program...\n");
            break;
        }

        if (buffer[0] < 1 || buffer[0] > 4) {
            printf("Invalid selection! Try again.\n");
            continue;
        }

        printf("Enter first number: ");
        scanf("%lf", &buffer[1]);

        printf("Enter second number: ");
        scanf("%lf", &buffer[2]);


        sendto(client_socket, buffer, sizeof(buffer), 0, (struct sockaddr *)&server_addr, addr_len);


        recvfrom(client_socket, &result, sizeof(result), 0, (struct sockaddr *)&server_addr, &addr_len);


        if (result == -999999) {
            printf("Server Error: Division by Zero is not allowed!\n");
        } else {
            printf("Result from server: %.2f\n", result);
        }
    }

    close(client_socket);
    return 0;
}
