#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
#include <arpa/inet.h>

#define PORT 2600

int main() {
    int server_socket;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len;
    double buffer[3];
    double result;
    pid_t pid;
    int choice;
    double num1, num2;


    server_socket = socket(AF_INET, SOCK_DGRAM, 0);
    if (server_socket < 0) {
        perror("Error creating socket");
        exit(EXIT_FAILURE);
    }


    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);


    if (bind(server_socket, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_socket);
        exit(EXIT_FAILURE);
    }


    signal(SIGCHLD, SIG_IGN);

    printf("Concurrent UDP RPC Server running on port %d...\n\n", PORT);


    while (1) {
        addr_len = sizeof(client_addr);


        if (recvfrom(server_socket, buffer, sizeof(buffer), 0, (struct sockaddr *)&client_addr, &addr_len) < 0) {
            perror("Recvfrom failed");
            continue;
        }


        pid = fork();

        if (pid == 0) {

            choice = (int)buffer[0];
            num1 = buffer[1];
            num2 = buffer[2];


            printf("[SERVER INFO] Client connected");
            char op_char;
            if (choice == 1) {
                result = num1 + num2;
                op_char = '+';
            } else if (choice == 2) {
                result = num1 - num2;
                op_char = '-';
            } else if (choice == 3) {
                result = num1 * num2;
                op_char = '*';
            } else if (choice == 4) {
                op_char = '/';
                if (num2 == 0) {
                    result = -999999;
                } else {
                    result = num1 / num2;
                }
            } else {
                op_char = '?';
                result = -888888;
            }


            if (result == -999999) {
                printf("[SERVER LOG] Operation requested: %.2f %c %.2f -> FAILED: Division by Zero\n\n", num1, op_char, num2);
            } else if (result == -888888) {
                printf("[SERVER LOG] Operation requested: Invalid Operation choice\n\n");
            } else {
                printf("[SERVER LOG] Operation requested: %.2f %c %.2f -> Computed Result: %.2f\n\n", num1, op_char, num2, result);
            }


            sendto(server_socket, &result, sizeof(result), 0, (struct sockaddr *)&client_addr, addr_len);


            exit(0);
        } else if (pid < 0) {
            perror("Fork failed");
        }

    }

    close(server_socket);
    return 0;
}
