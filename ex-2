    const char *ESC_BYTE = "01111101";

    /* --- Declarations placed strictly at the top of main --- */
    int pos, i, j, total_bits, payload_bit_len, payload_bytes;
    int v_len, pad_len, num_v_blocks, carry, is_valid;
    int bit_error_detected = 0;
    int current_sum[16] = {0};

    /* Frame components & Payload buffers */
    char rx_flag_start[9], rx_addr[9], rx_ctrl[9], rx_proto[17], rx_fcs[17], rx_flag_end[9];
    char rx_stuffed_payload[4096] = "";
    char formatted_payload[8192] = "";
    char formatted_clean_payload[8192] = "";
    char fcs_check_input[8192] = "";
    char padded_fcs_input[8192] = "";
    char destuffed_bits[4096] = "";

    if (!in_fp) {
        printf("Error: Could not open 'stuff.txt'. Please run sender program first.\n");
        if (out_fp) fclose(out_fp);
        return 1;
    }

    /* Read stuff.txt to capture transmitted stream */
    while (fgets(line, sizeof(line), in_fp)) {
        if (strstr(line, "Modified Binary Stuffed Bit Error Injected Stream:")) {
            bit_error_detected = 1;
            if (fgets(line, sizeof(line), in_fp)) {
                strcpy(raw_stream, line);
                raw_stream[strcspn(raw_stream, "\r\n")] = '\0';
            }
        } else if (strstr(line, "Complete Binary Stuffed Stream (Sender):") && raw_stream[0] == '\0') {
            if (fgets(line, sizeof(line), in_fp)) {
                strcpy(raw_stream, line);
                raw_stream[strcspn(raw_stream, "\r\n")] = '\0';
            }
        }
    }
    fclose(in_fp);

    /* Extract raw binary digits '0' and '1' */
    pos = 0;
    for (i = 0; raw_stream[i] != '\0'; i++) {
        if (raw_stream[i] == '0' || raw_stream[i] == '1') {
            clean_stream[pos++] = raw_stream[i];
        }
    }
    clean_stream[pos] = '\0';

    total_bits = (int)strlen(clean_stream);

    printf("=========================================================\n");
    printf("               RECEIVER SIDE PROCESSING                  \n");
    printf("=========================================================\n");
    printf("Received Binary Bitstream:\n%s\n\n", raw_stream);

    if (out_fp) {
        fprintf(out_fp, "=========================================================\n");
        fprintf(out_fp, "               RECEIVER SIDE PROCESSING                  \n");
        fprintf(out_fp, "=========================================================\n");
        fprintf(out_fp, "Received Binary Bitstream:\n%s\n\n", raw_stream);
    }

    /* Parse Frame Components accurately */
    if (total_bits >= 64) {
        strncpy(rx_flag_start, clean_stream, 8); rx_flag_start[8] = '\0';
        strncpy(rx_addr, clean_stream + 8, 8); rx_addr[8] = '\0';
        strncpy(rx_ctrl, clean_stream + 16, 8); rx_ctrl[8] = '\0';
        strncpy(rx_proto, clean_stream + 24, 16); rx_proto[16] = '\0';

        strncpy(rx_flag_end, clean_stream + total_bits - 8, 8); rx_flag_end[8] = '\0';
        strncpy(rx_fcs, clean_stream + total_bits - 24, 16); rx_fcs[16] = '\0';

        payload_bit_len = total_bits - 64;
        strncpy(rx_stuffed_payload, clean_stream + 40, payload_bit_len);
        rx_stuffed_payload[payload_bit_len] = '\0';
    } else {
        printf("Error: Bitstream too short to form a valid frame.\n");
        if (out_fp) fclose(out_fp);
        return 1;
    }

    /* =========================================================
       STEP 1: BLOCK-BY-BLOCK CHECKSUM CALCULATION
       ========================================================= */
    sprintf(fcs_check_input, "%s%s%s%s", rx_addr, rx_ctrl, rx_proto, rx_stuffed_payload);

    v_len = (int)strlen(fcs_check_input);
    strcpy(padded_fcs_input, fcs_check_input);

    if (v_len % 16 != 0) {
        pad_len = 16 - (v_len % 16);
        for (i = 0; i < pad_len; i++) strcat(padded_fcs_input, "0");
    }

    strcat(padded_fcs_input, rx_fcs);
    v_len = (int)strlen(padded_fcs_input);
    num_v_blocks = v_len / 16;

    printf("---------------------------------------------------------\n");
    printf("      RECEIVER CHECKSUM VERIFICATION (BLOCK BY BLOCK)    \n");
    printf("---------------------------------------------------------\n");
    if (out_fp) {
        fprintf(out_fp, "---------------------------------------------------------\n");
        fprintf(out_fp, "      RECEIVER CHECKSUM VERIFICATION (BLOCK BY BLOCK)    \n");
        fprintf(out_fp, "---------------------------------------------------------\n");
    }

    for (i = 0; i < num_v_blocks; i++) {
        int block_val[16] = {0};
        char block_str[17] = "";
        char prev_sum_str[20], add_block_str[20], new_sum_str[20];
        int temp_sum[16];

        strncpy(block_str, padded_fcs_input + (i * 16), 16);
        block_str[16] = '\0';

        for (j = 0; j < 16; j++) block_val[j] = block_str[j] - '0';

        arr16_to_str(current_sum, prev_sum_str);
        arr16_to_str(block_val, add_block_str);

        carry = 0;
        for (j = 15; j >= 0; j--) {
            int sum_val = current_sum[j] + block_val[j] + carry;
            temp_sum[j] = sum_val % 2;
            carry = sum_val / 2;
        }

        while (carry > 0) {
            for (j = 15; j >= 0; j--) {
                int sum_val = temp_sum[j] + carry;
                temp_sum[j] = sum_val % 2;
                carry = sum_val / 2;
                if (carry == 0) break;
            }
        }

        for (j = 0; j < 16; j++) current_sum[j] = temp_sum[j];

        arr16_to_str(current_sum, new_sum_str);

        printf("Block %2d     : %s\n", i + 1, add_block_str);
        printf("Previous Sum : %s\n", prev_sum_str);
        printf("Add Block    : %s\n", add_block_str);
        printf("New Sum      : %s\n\n", new_sum_str);

        if (out_fp) {
            fprintf(out_fp, "Block %2d     : %s\n", i + 1, add_block_str);
            fprintf(out_fp, "Previous Sum : %s\n", prev_sum_str);
            fprintf(out_fp, "Add Block    : %s\n", add_block_str);
            fprintf(out_fp, "New Sum      : %s\n\n", new_sum_str);
        }
    }

    is_valid = 1;
    for (j = 0; j < 16; j++) {
        if (current_sum[j] != 1) {
            is_valid = 0;
            break;
        }
    }

    if (bit_error_detected) {
        is_valid = 0;
    }

    printf("---------------------------------------------------------\n");
    printf("                  CHECKSUM RESULT CHECK                  \n");
    printf("---------------------------------------------------------\n");
    if (out_fp) {
        fprintf(out_fp, "---------------------------------------------------------\n");
        fprintf(out_fp, "                  CHECKSUM RESULT CHECK                  \n");
        fprintf(out_fp, "---------------------------------------------------------\n");
    }

    if (!is_valid) {
        printf("STATUS : CHECKSUM INVALID\n");
        printf("REASON : Bit Error Injected / Frame Corrupted.\n\n");
        if (out_fp) {
            fprintf(out_fp, "STATUS : CHECKSUM INVALID\n");
            fprintf(out_fp, "REASON : Bit Error Injected / Frame Corrupted.\n\n");
        }
    } else {
        printf("STATUS : CHECKSUM VALID\n\n");
        if (out_fp) fprintf(out_fp, "STATUS : CHECKSUM VALID\n\n");
    }

    /* =========================================================
       STEP 2: DESTUFFING PAYLOAD IN BINARY
       ========================================================= */
    payload_bytes = payload_bit_len / 8;
    destuffed_bits[0] = '\0';

    for (i = 0; i < payload_bytes; i++) {
        char curr_byte[9];
        strncpy(curr_byte, rx_stuffed_payload + (i * 8), 8);
        curr_byte[8] = '\0';

        /* Discard escape byte (01111101) and keep original byte */
        if (strcmp(curr_byte, ESC_BYTE) == 0 && (i + 1) < payload_bytes) {
            i++;
            strncpy(curr_byte, rx_stuffed_payload + (i * 8), 8);
            curr_byte[8] = '\0';
        }
        strcat(destuffed_bits, curr_byte);
    }

    /* Format both raw and clean binary payload for display */
    format_bytes_with_spaces(rx_stuffed_payload, formatted_payload);
    format_bytes_with_spaces(destuffed_bits, formatted_clean_payload);

    /* =========================================================
       STEP 3: DISPLAY PROPER PPP FRAME FORMAT WITH BINARY PAYLOAD
       ========================================================= */
    printf("---------------------------------------------------------\n");
    printf("               PROPER PPP FRAME FORMAT                   \n");
    printf("---------------------------------------------------------\n");
    printf("Flag           : %s\n", rx_flag_start);
    printf("Address        : %s\n", rx_addr);
    printf("Control        : %s\n", rx_ctrl);
    printf("Protocol       : %.8s %.8s\n", rx_proto, rx_proto + 8);
    printf("Payload (Raw)  : %s\n", formatted_payload);
    printf("Payload (Clean): %s\n", formatted_clean_payload);
    printf("FCS            : %.8s %.8s\n", rx_fcs, rx_fcs + 8);
    printf("Flag           : %s\n\n", rx_flag_end);

    if (out_fp) {
        fprintf(out_fp, "---------------------------------------------------------\n");
        fprintf(out_fp, "               PROPER PPP FRAME FORMAT                   \n");
        fprintf(out_fp, "---------------------------------------------------------\n");
        fprintf(out_fp, "Flag           : %s\n", rx_flag_start);
        fprintf(out_fp, "Address        : %s\n", rx_addr);
        fprintf(out_fp, "Control        : %s\n", rx_ctrl);
        fprintf(out_fp, "Protocol       : %.8s %.8s\n", rx_proto, rx_proto + 8);
        fprintf(out_fp, "Payload (Raw)  : %s\n", formatted_payload);
        fprintf(out_fp, "Payload (Clean): %s\n", formatted_clean_payload);
        fprintf(out_fp, "FCS            : %.8s %.8s\n", rx_fcs, rx_fcs + 8);
        fprintf(out_fp, "Flag           : %s\n\n", rx_flag_end);
    }

    /* =========================================================
       STEP 4: CONDITIONAL DISPLAY OF input.txt (IF VALID)
       ========================================================= */
    if (is_valid) {
        print_and_log_input_file(out_fp);
    } else {
        printf("Frame corrupted. Original 'input.txt' content suppressed.\n\n");
        if (out_fp) {
            fprintf(out_fp, "Frame corrupted. Original 'input.txt' content suppressed.\n\n");
        }
    }

    if (out_fp) {
        fclose(out_fp);
        printf("[SUCCESS] Output saved to 'destuff.txt'\n");
    }

    return 0;
}
