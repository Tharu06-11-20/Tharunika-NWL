    int b;
    for (b = 7; b >= 0; b--) bin_out[pos++] = ((code >> (b + 8)) & 1) ? '1' : '0';
    bin_out[pos++] = ' ';
    for (b = 7; b >= 0; b--) bin_out[pos++] = ((code >> b) & 1) ? '1' : '0';
    bin_out[pos] = '\0';
}

