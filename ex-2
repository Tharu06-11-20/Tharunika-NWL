void calculate_16bit_checksum(FILE *fp, const char *clean_bits, char *checksum_out) {
    int total_bits = (int)strlen(clean_bits);
    char padded_bits[8192];
    int p, num_blocks, i, j, pos, pad_len, carry;
    int current_sum[16] = {0};

    strcpy(padded_bits, clean_bits);
    if (total_bits % 16 != 0) {
        pad_len = 16 - (total_bits % 16);
        for (p = 0; p < pad_len; p++) strcat(padded_bits, "0");
        total_bits += pad_len;
    }

    num_blocks = total_bits / 16;

    printf("---------------------------------------------------------\n");
    printf("     CHECKSUM GENERATION (RUNNING ON STUFFED DATA)\n");
    printf("---------------------------------------------------------\n");
    if (fp) {
        fprintf(fp, "---------------------------------------------------------\n");
        fprintf(fp, "     CHECKSUM GENERATION (RUNNING ON STUFFED DATA)\n");
        fprintf(fp, "---------------------------------------------------------\n");
    }

    for (i = 0; i < num_blocks; i++) {
        int block_val[16] = {0};
        char block_str[17] = "";
        char prev_sum_str[20], add_block_str[20], new_sum_str[20];
        int temp_sum[16];

        strncpy(block_str, padded_bits + (i * 16), 16);
        block_str[16] = '\0';

        for (j = 0; j < 16; j++) {
            block_val[j] = block_str[j] - '0';
        }

        arr16_to_str(current_sum, prev_sum_str);
        arr16_to_str(block_val, add_block_str);

        carry = 0;
        for (j = 15; j >= 0; j--) {
            int sum_val = current_sum[j] + block_val[j] + carry;
            temp_sum[j] = sum_val % 2;
            carry = sum_val / 2;
        }

        while (carry > 0) {
            for (j = 15; j >= 0; j--) {
                int sum_val = temp_sum[j] + carry;
                temp_sum[j] = sum_val % 2;
                carry = sum_val / 2;
                if (carry == 0) break;
            }
        }

        for (j = 0; j < 16; j++) {
            current_sum[j] = temp_sum[j];
        }

        arr16_to_str(current_sum, new_sum_str);

        printf("Block %2d     : %s\n", i + 1, add_block_str);
        printf("Previous Sum : %s\n", prev_sum_str);
        printf("Add Block    : %s\n", add_block_str);
        printf("New Sum      : %s\n\n", new_sum_str);

        if (fp) {
            fprintf(fp, "Block %2d     : %s\n", i + 1, add_block_str);
            fprintf(fp, "Previous Sum : %s\n", prev_sum_str);
            fprintf(fp, "Add Block    : %s\n", add_block_str);
            fprintf(fp, "New Sum      : %s\n\n", new_sum_str);
        }
    }

    pos = 0;
    for (j = 0; j < 16; j++) {
        checksum_out[pos++] = (!current_sum[j]) + '0';
        if (j == 7) checksum_out[pos++] = ' ';
    }
    checksum_out[pos] = '\0';
}

