void str_to_binary(const char *input, char *binary_out) {
    int i, b, val;
    char temp_byte[9];
    binary_out[0] = '\0';

    for (i = 0; input[i] != '\0'; i++) {
        unsigned char c = input[i];
        val = (int)c;
        temp_byte[8] = '\0';

        for (b = 7; b >= 0; b--) {
            temp_byte[b] = (val % 2) + '0';
            val /= 2;
        }
        strcat(binary_out, temp_byte);
        if (input[i + 1] != '\0') strcat(binary_out, " ");
    }
}

void port_to_binary(unsigned short port, char *bin_out) {
    int pos = 0;
    int b;
    for (b = 7; b >= 0; b--) bin_out[pos++] = ((port >> (b + 8)) & 1) ? '1' : '0';
    bin_out[pos++] = ' ';
    for (b = 7; b >= 0; b--) bin_out[pos++] = ((port >> b) & 1) ? '1' : '0';
    bin_out[pos] = '\0';
}

void ip_to_binary(const char *ip, char *bin_out) {
    int octets[4];
    int i, b;
    bin_out[0] = '\0';
    if (sscanf(ip, "%d.%d.%d.%d", &octets[0], &octets[1], &octets[2], &octets[3]) != 4) return;

    for (i = 0; i < 4; i++) {
        for (b = 7; b >= 0; b--) {
            strcat(bin_out, ((octets[i] >> b) & 1) ? "1" : "0");
            if (b == 0 && i < 3) strcat(bin_out, " ");
        }
    }
}

void proto_to_binary(unsigned short code, char *bin_out) {
