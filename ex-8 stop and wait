#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 9080

typedef struct Packet {
    int seq_num;
    int ack_num;
    char content[50];
    int test_case;
} Packet;

int main() {
    int server_fd, new_socket;
    struct sockaddr_in address;
    int addrlen = sizeof(address);

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
        perror("Bind failed");
        exit(EXIT_FAILURE);
    }

    if (listen(server_fd, 3) < 0) {
        perror("Listen failed");
        exit(EXIT_FAILURE);
    }

    printf("=========================================\n");
    printf("  ITERATIVE RECEIVER SIDE (STOP-AND-WAIT)\n");
    printf("=========================================\n");
    printf("Listening for Sender connections on port %d...\n\n", PORT);


    while (1) {
        printf("Waiting next sender to connect...\n");
        new_socket = accept(server_fd, (struct sockaddr *)&address, (socklen_t*)&addrlen);
        if (new_socket < 0) {
            perror("Accept failed");
            continue;
        }

        printf("\n>>> Sender connected! Processing transmission... <<<\n");

        int expected_seq = 0;
        Packet pkt;


        while (read(new_socket, &pkt, sizeof(Packet)) > 0) {

            if (pkt.test_case == 999) {
                expected_seq = 0;
                continue;
            }

            printf("-----------------------------------------\n");


            if (pkt.test_case == 1 && pkt.seq_num == 1) {
                printf("[RECEIVER] Packet Loss Simulated! Dropping Frame %d.\n", pkt.seq_num);
                pkt.test_case = 0;
                continue;
            }


            if (pkt.test_case == 3 && pkt.seq_num == 1) {
                printf("[RECEIVER] Mismatch! Expected Frame %d, received corrupt Frame 99.\n", expected_seq);
                Packet ack;
                ack.ack_num = expected_seq;
                printf("[RECEIVER] Sending ACK %d to request missing frame.\n", ack.ack_num);
                send(new_socket, &ack, sizeof(Packet), 0);
                pkt.test_case = 0;
                continue;
            }

            if (pkt.seq_num == expected_seq) {
                printf("[RECEIVER] Received Frame %d: \"%s\"\n", pkt.seq_num, pkt.content);
                expected_seq++;
                Packet ack;
                ack.ack_num = expected_seq;
                printf("[RECEIVER] Frame accepted. Sending ACK %d.\n", ack.ack_num);
                send(new_socket, &ack, sizeof(Packet), 0);
            }
        }

        printf("\n[RECEIVER] Client transmission complete. Closing connection.\n");
        printf("=========================================\n\n");
        close(new_socket);
    }

    close(server_fd);
    return 0;
}

