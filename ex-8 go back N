#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 5080

typedef struct Packet {
    int seq_num;
    char data[50];
    int ack_num;
    int drop_sim;
} Packet;

int main() {
    int server_fd, new_socket;
    struct sockaddr_in address;
    int addrlen = sizeof(address);

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
        perror("Bind failed");
        exit(EXIT_FAILURE);
    }

    if (listen(server_fd, 3) < 0) {
        perror("Listen failed");
        exit(EXIT_FAILURE);
    }

    printf("=========================================\n");
    printf("     ITERATIVE RECEIVER (GO-BACK-N)      \n");
    printf("=========================================\n");
    printf("Status: Receiver online. Listening on port %d...\n\n", PORT);


    while (1) {
        printf("Waiting for a new Sender connection...\n");
        new_socket = accept(server_fd, (struct sockaddr *)&address, (socklen_t*)&addrlen);
        if (new_socket < 0) {
            perror("Accept failed");
            continue;
        }

        printf("\n>>> Status: Connection established with a new Sender! <<<\n");


        int expected_seq = 0;
        Packet pkt;


        while (read(new_socket, &pkt, sizeof(Packet)) > 0) {
            printf("-----------------------------------------\n");
            printf("[RECEIVER] Arrived: Frame %d | Content: \"%s\"\n", pkt.seq_num, pkt.data);

            if (pkt.drop_sim == 1) {
                printf("[SIMULATION] Frame %d was dropped/corrupted in transit!\n", pkt.seq_num);
                printf("[RECEIVER] Action: Ignoring frame and waiting for retransmission.\n");
                continue;
            }

            if (pkt.seq_num == expected_seq) {
                printf("[RECEIVER] Verification Passed: Frame %d is in sequence.\n", pkt.seq_num);
                expected_seq++;

                Packet ack;
                memset(&ack, 0, sizeof(Packet));
                ack.ack_num = expected_seq;
                printf("[RECEIVER] Action: Transmitting ACK %d back to Sender.\n", expected_seq);
                send(new_socket, &ack, sizeof(Packet), 0);
            } else {
                printf("[RECEIVER] Verification Failed: Expected Frame %d, got Frame %d.\n", expected_seq, pkt.seq_num);
                printf("[RECEIVER] Action: Discarding out-of-order frame.\n");
                Packet ack;
                memset(&ack, 0, sizeof(Packet));
                ack.ack_num = expected_seq;
                printf("[RECEIVER] Action: Resending ACK %d.\n", expected_seq);
                send(new_socket, &ack, sizeof(Packet), 0);
            }
        }

        printf("\nStatus: Current client transmission complete. Closing connection.\n");
        printf("=================================================================\n\n");
        close(new_socket);
    }

    close(server_fd);
    return 0;
}

