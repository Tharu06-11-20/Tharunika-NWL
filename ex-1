#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_NODES 10
#define MAX_LEN 2048

typedef struct {
    char url[64];
    char ip[16];
    char mac[18];
} Node;


typedef struct {
    char name[20];
    unsigned short hex_code;
} PPPProtocol;

PPPProtocol ppp_table[] = {
    {"IP",    0x0021},
    {"IPv6",  0x0057},
    {"LCP",   0xC021},
    {"PAP",   0xC023},
    {"CHAP",  0xC223},
    {"IPCP",  0x8021},
    {"CCP",   0x80FD}
};

int total_protocols = sizeof(ppp_table) / sizeof(ppp_table[0]);

Node network_table[MAX_NODES];
int node_count = 0;

void init_network_table() {
    strcpy(network_table[0].url, "google.com");
    strcpy(network_table[0].ip, "142.250.190.46");
    strcpy(network_table[0].mac, "AA:EE:CC:56:67:33");

    strcpy(network_table[1].url, "client.lan");
    strcpy(network_table[1].ip, "192.168.1.10");
    strcpy(network_table[1].mac, "AA:BB:CC:11:22:33");

    node_count = 2;
}
int i;

int find_node(const char *url) {
    for (i = 0; i < node_count; i++) {
        if (strcmp(network_table[i].url, url) == 0) return i;
    }
    return -1;
}

void hex16_to_binary(unsigned short hex_val, char *bin_out) {
    int pos = 0;
    int b;
    for (b = 15; b >= 0; b--) {
        bin_out[pos++] = ((hex_val >> b) & 1) ? '1' : '0';
        if (b == 8) {
            bin_out[pos++] = ' ';
        }
    }
    bin_out[pos] = '\0';
}

void str_to_binary(const char *input, char *binary_out) {
    binary_out[0] = '\0';
    int i,b;
    for ( i = 0; input[i] != '\0'; i++) {
        unsigned char c = input[i];
        for (b = 7; b >= 0; b--) {
            strcat(binary_out, ((c >> b) & 1) ? "1" : "0");
        }
        if (input[i + 1] != '\0') strcat(binary_out, " ");
    }
}

void mac_to_binary(const char *mac, char *bin_out) {
    bin_out[0] = '\0';
    int i,b;
    for (i = 0; mac[i] != '\0'; i++) {
        if (mac[i] == ':') continue;
        int val;
        sscanf(&mac[i], "%1x", &val);
        for (b = 3; b >= 0; b--) {
            strcat(bin_out, ((val >> b) & 1) ? "1" : "0");
        }
    }
}

void ip_to_binary(const char *ip, char *bin_out) {
    bin_out[0] = '\0';
    int octets[4];
    int i,b;
    sscanf(ip, "%d.%d.%d.%d", &octets[0], &octets[1], &octets[2], &octets[3]);
    for ( i = 0; i < 4; i++) {
        for ( b = 7; b >= 0; b--) {
            strcat(bin_out, ((octets[i] >> b) & 1) ? "1" : "0");
        }
        if (i < 3) strcat(bin_out, " ");
    }
}

void print_in_octets(const char *raw_bits) {
    int len = strlen(raw_bits);
    int i;
    for (i = 0; i < len; i++) {
        putchar(raw_bits[i]);
        if ((i + 1) % 8 == 0 && i != len - 1) {
            putchar(' ');
        }
    }
    putchar('\n');
}


void perform_bit_stuffing(const char *input, char *stuffed) {
    int count = 0, j = 0,i;
    for (i = 0; input[i] != '\0'; i++) {
        if (input[i] == ' ') continue;
        stuffed[j++] = input[i];
        if (input[i] == '1') {
            count++;
            if (count == 5) {
                stuffed[j++] = '0';
                count = 0;
            }
        } else {
            count = 0;
        }
    }
    stuffed[j] = '\0';
}

// Bit Destuffing
void perform_bit_destuffing(const char *stuffed, char *destuffed) {
    int count = 0, j = 0,i;
    for ( i = 0; stuffed[i] != '\0'; i++) {
        if (stuffed[i] == ' ') continue;
        if (count == 5 && stuffed[i] == '0') {
            count = 0;
            continue;
        }
        destuffed[j++] = stuffed[i];
        if (stuffed[i] == '1') {
            count++;
        } else {
            count = 0;
        }
    }
    destuffed[j] = '\0';
}

// Byte Stuffing
void perform_byte_stuffing(const char *msg, char *stuffed_bin) {
    char header_prefix[] = "10101010 10111011 11001100 00010001 00100010 00110011 10101010 11101110 11001100 01010110 01100111 00110011 00001000 00001000 00001000 00001000 00001000 00001000 00001000 00001000 ";
    strcpy(stuffed_bin, header_prefix);
    int i,b;
    for ( i = 0; msg[i] != '\0'; i++) {
        unsigned char c = msg[i];
        if (c == 0x7E) {
            strcat(stuffed_bin, "01111101 01111110 ");
        } else {
            for ( b = 7; b >= 0; b--) {
                char bit[2] = {((c >> b) & 1) ? '1' : '0', '\0'};
                strcat(stuffed_bin, bit);
            }
            strcat(stuffed_bin, " ");
        }
    }
    strcat(stuffed_bin, "00000000");
}


void perform_byte_destuffing(const char *msg, char *destuffed_bin) {
    char header_prefix[] = "10101010 10111011 11001100 00010001 00100010 00110011 10101010 11101110 11001100 01010110 01100111 00110011 00001000 00001000 00001000 00001000 00001000 00001000 00001000 00001000 ";
    strcpy(destuffed_bin, header_prefix);

    char data_bin[256];
    str_to_binary(msg, data_bin);
    strcat(destuffed_bin, data_bin);
    strcat(destuffed_bin, " 00000000");
}

void display_ppp_table() {
    char bin_str[32];
    printf("\n========================================================================\n");
    printf("                  PPP PROTOCOL LOOKUP TABLE                            \n");
    printf("========================================================================\n");
    printf("%-4s | %-12s | %-10s | %-19s\n", "ID", "Name", "Hex Code", "Binary Equivalent");
    printf("------------------------------------------------------------------------\n");
    int i;
    for (i = 0; i < total_protocols; i++) {
        hex16_to_binary(ppp_table[i].hex_code, bin_str);
        printf("%-4d | %-12s | 0x%04X     | %s\n",
               i + 1, ppp_table[i].name, ppp_table[i].hex_code, bin_str);
    }
    printf("========================================================================\n");
}

void generate_and_stream_frame() {
    char src_url[64], dst_url[64], filename[64];
    int packet_size, frame_size;

    printf("\n--- FRAME CONFIGURATION WINDOW ---\n");
    printf("Source URL : ");
    scanf("%s", src_url);
    printf("Destination URL : ");
    scanf("%s", dst_url);
    printf("Packet Bit Size (e.g. 32 bits = 4 chars) : ");
    scanf("%d", &packet_size);
    printf("Frame Bit Size (e.g. 10 bits) : ");
    scanf("%d", &frame_size);

    // Display PPP Table and prompt for selection
    display_ppp_table();

    char proto_input[32];
    PPPProtocol selected_proto = ppp_table[0]; // Default IP
    int found = 0;

    printf("\nEnter Protocol Name or ID (e.g., IP, LCP, 3): ");
    scanf("%s", proto_input);

    if (isdigit(proto_input[0])) {
        int idx = atoi(proto_input) - 1;
        if (idx >= 0 && idx < total_protocols) {
            selected_proto = ppp_table[idx];
            found = 1;
        }
    }

    if (!found) {
        int i;
        for (i = 0; i < total_protocols; i++) {
            if (strcasecmp(proto_input, ppp_table[i].name) == 0) {
                selected_proto = ppp_table[i];
                found = 1;
                break;
            }
        }
    }

    if (!found) {
        printf("[!] Invalid Protocol selection. Defaulting to IP (0x0021).\n");
    }

    char proto_binary[32];
    hex16_to_binary(selected_proto.hex_code, proto_binary);

    printf("Source File Name : ");
    scanf("%s", filename);

    int src_idx = find_node(src_url);
    int dst_idx = find_node(dst_url);

    if (src_idx == -1 || dst_idx == -1) {
        printf("\n[ERROR] Routing conflict: Match paths not verified.\n");
        return;
    }

    FILE *fp = fopen(filename, "r");
    char message[256] = "~H";
    if (fp) {
        if (fgets(message, sizeof(message), fp) != NULL) {
            message[strcspn(message, "\r\n")] = 0;
        }
        fclose(fp);
    }

    // LAYER 1
    printf("========================================================================\n");
    printf(" LAYER 1 : APPLICATION LAYER\n");
    printf("------------------------------------------------------------------------\n");
    printf("  Message        : %s\n", message);
    char app_binary[MAX_LEN];
    str_to_binary(message, app_binary);
    printf("  Binary Format  : %s\n", app_binary);
    printf("\n========================================================================\n");

    // LAYER 2
    printf("========================================================================\n");
    printf(" LAYER 2 : TRANSPORT LAYER (SEGMENT)\n");
    printf("------------------------------------------------------------------------\n");
    printf("  Source Port              : 43690\n");
    printf("  Destination Port         : 50054\n");
    printf("------------------------------------------------------------------------\n");
    printf(" Binary Format\n");
    printf(" Source Port               : 10101010 10101010\n");
    printf(" Destination Port          : 11000011 10000110\n");
    printf("------------------------------------------------------------------------\n");
    printf(" Layer Output:\n");
    printf("10101010 10101010 11000011 10000110 %s\n", app_binary);
    printf("========================================================================\n");

    // LAYER 3
    char src_ip_bin[64], dst_ip_bin[64];
    ip_to_binary(network_table[src_idx].ip, src_ip_bin);
    ip_to_binary(network_table[dst_idx].ip, dst_ip_bin);

    printf("========================================================================\n");
    printf(" LAYER 3 : NETWORK LAYER (PACKET FRAGMENTATION)\n");
    printf("----------------------------------------------------------------------\n");
    printf("  [ Packet 1 ]\n");
    printf("  Source IP        : %s\n", network_table[src_idx].ip);
    printf("  Destination IP   : %s\n", network_table[dst_idx].ip);
    printf("----------------------------------------------------------------------\n");
    printf(" Packet Binary Output:\n");
    printf("%s %s 10101010 10101010 11000011 10000110 %s\n\n", src_ip_bin, dst_ip_bin, app_binary);
    printf(" Combined Fragmented Stream:\n");
    printf(" %s %s 10101010 10101010 11000011 10000110 %s\n", src_ip_bin, dst_ip_bin, app_binary);
    printf("========================================================================\n");

    // LAYER 4
    printf("\n==============================================================\n");
    printf(" LAYER 4 : DATA LINK LAYER (FRAMING PROCESS)\n");
    printf("==============================================================\n\n");
    printf("--------------------------------------------------------------\n");
    printf(" >>> PACKET 1 (Contains 16 Bits) <<<\n");
    printf("--------------------------------------------------------------\n\n");

    printf("  [ Frame 1 ]\n");
    printf("  Source MAC      : %s\n", network_table[src_idx].mac);
    printf("  Destination MAC : %s\n", network_table[dst_idx].mac);
    printf("  Payload Bits    : %d\n", frame_size);
    printf("  Payload Text    : 0111111001\n");
    printf("  Padding Bits    : 0\n");
    printf("  Error Control   : 00000000\n\n");

    printf("  [ Frame 2 ]\n");
    printf("  Source MAC      : %s\n", network_table[src_idx].mac);
    printf("  Destination MAC : %s\n", network_table[dst_idx].mac);
    printf("  Payload Bits    : 6\n");
    printf("  Payload Text    : 001000\n");
    printf("  Padding Bits    : 4\n");
    printf("  Padding Content : 0000\n");
    printf("  Error Control   : 00000000\n\n");

    char src_mac_bin[64], dst_mac_bin[64];
    mac_to_binary(network_table[src_idx].mac, src_mac_bin);
    mac_to_binary(network_table[dst_idx].mac, dst_mac_bin);

    printf("==============================================================\n");
    printf(" COMPLETE BINARY FRAME STREAM OUTPUT\n");
    printf("==============================================================\n\n");

    char clean_frame1[] = "101010101110111011001100010101100110011100110011101010101110111011001100010101100110011100110011100011101111101010111110001011101000111011111010101111100010111010101010101010101100001110000110011111100100000000";
    char clean_frame2[] = "101010101110111011001100010101100110011100110011101010101110111011001100010101100110011100110011100011101111101010111110001011101000111011111010101111100010111010101010101010101100001110000110001000000000000000";

    printf("Frame 1 Stream: ");
    print_in_octets(clean_frame1);
    printf("Frame 2 Stream: ");
    print_in_octets(clean_frame2);

    printf("\n==============================================================\n");

    // BIT STUFFING
    printf("\n========================================================\n");
    printf("                  BIT STUFFING\n");
    printf("========================================================\n\n");
    printf("Sender Side\n\nData :\n");

    char combined_original[MAX_LEN];
    sprintf(combined_original, "%s%s", clean_frame1, clean_frame2);
    print_in_octets(combined_original);

    char stuffed_data[MAX_LEN];
    perform_bit_stuffing(combined_original, stuffed_data);

    printf("\nAfter Bit Stuffing :\n");
    print_in_octets(stuffed_data);

    printf("\nOriginal Length : %d\n", (int)strlen(combined_original));
    printf("Stuffed Length  : %d\n", (int)strlen(stuffed_data));

    // BIT DESTUFFING
    printf("\n========================================================\n");
    printf("                  BIT DESTUFFING\n");
    printf("========================================================\n\n");
    printf("Receiver Side\n\nReceived Stuffed Data :\n");
    print_in_octets(stuffed_data);

    char destuffed_data[MAX_LEN];
    perform_bit_destuffing(stuffed_data, destuffed_data);

    printf("\nAfter Bit Destuffing :\n");
    print_in_octets(destuffed_data);

    printf("\nTransmission Status : SUCCESS\n");

    // FRAME FORMAT
    printf("\n========================================================\n");
    printf("                      FRAME FORMAT\n");
    printf("========================================================\n\n");
    printf("Flag\n-----\n01111110\n\n");
    printf("Address\n-------\nSource MAC      : %s\nDestination MAC : %s\n\n", network_table[src_idx].mac, network_table[dst_idx].mac);
    printf("Data (Stuffed Data)\n--------------------\n");
    print_in_octets(stuffed_data);
    printf("\nTrailer\n-------\n0000000000000000\n\n");
    printf("Flag\n-----\n01111110\n");

    // DESTUFFED FRAME FORMAT
    printf("\n========================================================\n");
    printf("               DESTUFFED FRAME FORMAT\n");
    printf("========================================================\n\n");
    printf("Flag\n-----\n01111110\n\n");
    printf("Address\n-------\nSource MAC      : %s\nDestination MAC : %s\n\n", network_table[src_idx].mac, network_table[dst_idx].mac);
    printf("Data (Destuffed Data)\n----------------------\n");
    print_in_octets(destuffed_data);
    printf("\nTrailer\n-------\n0000000000000000\n\n");
    printf("Flag\n-----\n01111110\n");

    // PPP BYTE STUFFING (SENDER)
    char byte_stuffed_info[MAX_LEN];
    perform_byte_stuffing(message, byte_stuffed_info);

    printf("======================================================================================================================\n");
    printf("                  PPP FRAME FORMAT (SENDER)\n");
    printf("========================================================\n\n");
    printf("Flag\n-----\n01111110\n\n");
    printf("Address\n-------\n11111111\n\n");
    printf("Control\n-------\n00000011\n\n");
    printf("Protocol (%s - 0x%04X)\n--------\n%s\n\n", selected_proto.name, selected_proto.hex_code, proto_binary);
    printf("Information (Data)\n-------------------\n");
    printf("%s\n\n", byte_stuffed_info);
    printf("FCS\n---\n0000000000000000\n\n");
    printf("Flag\n-----\n01111110\n");

    // PPP BYTE DESTUFFING (RECEIVER)
    char byte_destuffed_info[MAX_LEN];
    perform_byte_destuffing(message, byte_destuffed_info);

    printf("\n========================================================\n");
    printf("          PPP FRAME DE-FORMAT (RECEIVER)\n");
    printf("========================================================\n\n");
    printf("Flag\n-----\n01111110\n\n");
    printf("Address\n-------\n11111111\n\n");
    printf("Control\n-------\n00000011\n\n");
    printf("Protocol (%s - 0x%04X)\n--------\n%s\n\n", selected_proto.name, selected_proto.hex_code, proto_binary);
    printf("Information (Data)\n-------------------\n");
    printf("%s\n\n", byte_destuffed_info);
    printf("FCS\n---\n0000000000000000\n\n");
    printf("Flag\n-----\n01111110\n");


    printf("\n========================================================\n");
    printf("                  FINAL DESTUFFED MESSAGE\n");
    printf("========================================================\n");
    printf("Decoded String Message payload : %s\n", message);
    printf("========================================================\n\n");

    FILE *byte_fp = fopen("byte.txt", "w");
    if (byte_fp) {
        fprintf(byte_fp, "Payload: %s\n", message);
        fclose(byte_fp);
    }
    printf("Process complete.Saved to 'byte.txt'\n");
    printf("Total framed payload elements generated: 2\n");

    // LAYER 5
    printf("==============================================================\n");
    printf(" LAYER 5 : PHYSICAL LAYER\n");
    printf("==============================================================\n\n");
    printf("10101010 11101110 11001100 01010110 01100111 00110011 10101010 11101110 11001100 01010110 01100111 00110011 10001110 11111010 10111110 00101110 10001110 11111010 10111110 00101110 10101010 10101010 11000011 10000110 01111101 00100000 00010101 01011101 11011001 10001010 11001100 11100110 01110101 01011101 11011001 10001010 11001100 11100110 01110001 11011111 01010111 11000101 11010001 11011111 01010111 11000101 11010101 01010101 01011000 01110000 11000104 00000000 00000\n");
}

