#include <stdio.h>
#include <string.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <sys/socket.h>

#define PORT 8030

int main(int argc, char *argv[])
{
    int sockfd;
    struct sockaddr_in server;
    socklen_t serverSize;

    char clientName[100];
    int requestedSubnet;

    char ip[50];
    char mask[50];
    char gateway[50];

    if (argc != 2)
    {
        printf("Usage: ./dhcp_client <server_ip>\n");
        return 0;
    }

    printf("\n================ DHCP CLIENT ================\n\n");

    printf("Enter Client Name : ");
    if(scanf(" %[^\n]", clientName) != 1) return 1;

    printf("Enter Required Subnet Number : ");
    if(scanf("%d", &requestedSubnet) != 1) return 1;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0)
    {
        printf("Socket creation failed!\n");
        return 0;
    }

    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    server.sin_addr.s_addr = inet_addr(argv[1]);
    serverSize = sizeof(server);


    sendto(sockfd, clientName, strlen(clientName) + 1, 0, (struct sockaddr *)&server, serverSize);


    sendto(sockfd, &requestedSubnet, sizeof(requestedSubnet), 0, (struct sockaddr *)&server, serverSize);

    printf("\nSent Request to Server. Waiting for configuration parameters...\n");


    recvfrom(sockfd, ip, sizeof(ip), 0, (struct sockaddr *)&server, &serverSize);

    if (strcmp(ip, "Invalid Subnet") == 0) {
        printf("\nError: Server rejected the subnet allocation request.\n");
        close(sockfd);
        return 0;
    }


    recvfrom(sockfd, mask, sizeof(mask), 0, (struct sockaddr *)&server, &serverSize);


    recvfrom(sockfd, gateway, sizeof(gateway), 0, (struct sockaddr *)&server, &serverSize);

    printf("\n================ RECEIVED CONFIGURATION ================\n");
    printf("Assigned IP Address : %s\n", ip);
    printf("Subnet Mask         : %s\n", mask);
    printf("Default Gateway     : %s\n", gateway);
    printf("========================================================\n");

    close(sockfd);
    return 0;
}
