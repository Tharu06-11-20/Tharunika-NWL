#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <signal.h>

#define PORT 3870
#define BUFFER_SIZE 1024

struct dns_record {
    char domain[100];
    char ip[50];
};

struct dns_record dns_table[] = {
    {"google.com", "142.250.195.14"},
    {"youtube.com", "142.250.72.14"},
    {"facebook.com", "157.240.241.35"},
    {"example.com", "93.184.216.34"}
};

int total_records = 4;

int main() {
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    socklen_t addr_len;
    int i;


    signal(SIGCHLD, SIG_IGN);


    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) {
        perror("Socket creation failed");
        return 1;
    }


    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;


    if (bind(sockfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    printf("Concurrent UDP DNS Server running on port %d...\n", PORT);


    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        addr_len = sizeof(client_addr);


        int bytes_received = recvfrom(sockfd, buffer, BUFFER_SIZE - 1, 0,
                                      (struct sockaddr *)&client_addr, &addr_len);

        if (bytes_received < 0) continue;
        buffer[bytes_received] = '\0';


        if (fork() == 0) {

            printf("\nClient requested: %s\n", buffer);

            if (strcmp(buffer, "exit") == 0) {
                strcpy(response, "DNS Server stopped");
            } else {
                int found = 0;
                for (i = 0; i < total_records; i++) {
                    if (strcmp(buffer, dns_table[i].domain) == 0) {
                        strcpy(response, dns_table[i].ip);
                        found = 1;
                        break;
                    }
                }
                if (!found) {
                    strcpy(response, "Domain not found");
                }
            }


            sendto(sockfd, response, strlen(response), 0,
                   (struct sockaddr *)&client_addr, addr_len);
            printf("Response sent: %s\n", response);

            exit(0);
        }
    }

    close(sockfd);
    return 0;
}
