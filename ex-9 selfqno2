#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define MAX 100

struct Weather {
    int seq;
    char location[50];
    float temperature;
    float humidity;
    float pressure;
    float wind;
};

struct LocationData {
    char location[50];
    int count;
    float temperature;
    float humidity;
    float pressure;
    float wind;
};

int main() {
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);

    struct Weather w;
    struct LocationData data[MAX];
    int locationCount = 0;
    int lastSeq = 0;

    char buffer[100];

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0) {
        printf("Socket creation failed\n");
        return 1;
    }

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr *)&server, sizeof(server)) < 0) {
        printf("Bind failed\n");
        return 1;
    }

    printf("Weather Server started...\n");

    while (1) {

        recvfrom(sockfd, &w, sizeof(w), 0,
                 (struct sockaddr *)&client, &len);

        if (w.seq <= lastSeq) {
            printf("Duplicate packet received: %d\n", w.seq);

            strcpy(buffer, "DUPLICATE");
            sendto(sockfd, buffer, sizeof(buffer), 0,
                   (struct sockaddr *)&client, len);

            continue;
        }

        if (w.seq > lastSeq + 1) {
            printf("Missing packet detected\n");
        }

        lastSeq = w.seq;

        printf("\nPacket received\n");
        printf("Sequence Number : %d\n", w.seq);
        printf("Location        : %s\n", w.location);
        printf("Temperature     : %.2f\n", w.temperature);
        printf("Humidity        : %.2f\n", w.humidity);
        printf("Pressure        : %.2f\n", w.pressure);
        printf("Wind Speed      : %.2f\n", w.wind);

        int found = -1;

        for (int i = 0; i < locationCount; i++) {
            if (strcmp(data[i].location, w.location) == 0) {
                found = i;
                break;
            }
        }

        if (found == -1) {
            strcpy(data[locationCount].location, w.location);
            data[locationCount].count = 1;
            data[locationCount].temperature = w.temperature;
            data[locationCount].humidity = w.humidity;
            data[locationCount].pressure = w.pressure;
            data[locationCount].wind = w.wind;

            locationCount++;
        }
        else {
            data[found].count++;
            data[found].temperature += w.temperature;
            data[found].humidity += w.humidity;
            data[found].pressure += w.pressure;
            data[found].wind += w.wind;
        }

        strcpy(buffer, "ACK");

        sendto(sockfd, buffer, sizeof(buffer), 0,
               (struct sockaddr *)&client, len);

        printf("ACK sent\n");

        printf("\nAverage Weather Data:\n");

        for (int i = 0; i < locationCount; i++) {

            printf("\nLocation: %s\n",
                   data[i].location);

            printf("Average Temperature: %.2f\n",
                   data[i].temperature / data[i].count);

            printf("Average Humidity: %.2f\n",
                   data[i].humidity / data[i].count);

            printf("Average Pressure: %.2f\n",
                   data[i].pressure / data[i].count);

            printf("Average Wind Speed: %.2f\n",
                   data[i].wind / data[i].count);
        }
    }

    close(sockfd);

    return 0;
}
