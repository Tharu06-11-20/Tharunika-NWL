#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>

#define PORT 8080

struct Weather {
    int seq;
    char location[50];
    float temperature;
    float humidity;
    float pressure;
    float wind;
};

int main() {

    int sockfd;
    struct sockaddr_in server;
    socklen_t len = sizeof(server);

    struct Weather w;

    char buffer[100];

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0) {
        printf("Socket creation failed\n");
        return 1;
    }

    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    server.sin_addr.s_addr = inet_addr("127.0.0.1");

    int sequence = 1;

    while (1) {

        printf("\nEnter location: ");
        scanf("%s", w.location);

        printf("Enter temperature: ");
        scanf("%f", &w.temperature);

        printf("Enter humidity: ");
        scanf("%f", &w.humidity);

        printf("Enter pressure: ");
        scanf("%f", &w.pressure);

        printf("Enter wind speed: ");
        scanf("%f", &w.wind);

        w.seq = sequence;

        while (1) {

            sendto(sockfd, &w, sizeof(w), 0,
                   (struct sockaddr *)&server, len);

            printf("\nPacket %d sent\n", sequence);

            fd_set readfds;

            FD_ZERO(&readfds);
            FD_SET(sockfd, &readfds);

            struct timeval timeout;

            timeout.tv_sec = 3;
            timeout.tv_usec = 0;

            int result = select(sockfd + 1,
                                &readfds,
                                NULL,
                                NULL,
                                &timeout);

            if (result > 0) {

                recvfrom(sockfd, buffer, sizeof(buffer), 0,
                         (struct sockaddr *)&server, &len);

                if (strcmp(buffer, "ACK") == 0) {
                    printf("ACK received\n");
                    break;
                }
            }
            else {
                printf("Timeout! Retransmitting...\n");
            }
        }

        sequence++;

        printf("\nSend another packet? (1-Yes / 0-No): ");

        int choice;
        scanf("%d", &choice);

        if (choice == 0)
            break;
    }

    close(sockfd);

    return 0;
}
